# --- ZecCheckout server ---------------------------------------------------
# Network: testnet (default) or mainnet
ZC_NETWORK=testnet
# Your Unified Full Viewing Key (uview... / uviewtest...). NEVER a spending key or seed.
ZC_UFVK=
# ...or read it from a file instead:
# ZC_UFVK_FILE=/path/to/ufvk.txt
# lightwalletd (gRPC). Strongly prefer your own instance; see README "Threat model".
# ZC_LIGHTWALLETD=https://testnet.zec.rocks:443
# Merchant API bearer token (>= 24 chars). Generate: openssl rand -hex 24
ZC_API_KEY=
# Webhook endpoint of your shop backend and the HMAC secret (>= 24 chars)
ZC_WEBHOOK_URL=http://127.0.0.1:8081/webhook
ZC_WEBHOOK_SECRET=
ZC_BIND=127.0.0.1:8080
ZC_PUBLIC_URL=http://127.0.0.1:8080
# Origins allowed to embed the checkout iframe (space separated)
ZC_FRAME_ANCESTORS=http://127.0.0.1:8081
ZC_MERCHANT_NAME=Shielded Coffee
ZC_MIN_CONFIRMATIONS=3
ZC_INVOICE_TTL_SECS=3600
ZC_DB=zeccheckout.db
# Optional: block height to start scanning from on first run (default: current tip)
# ZC_BIRTHDAY=
# Include a ZIP-321 memo ("zeccheckout invoice <id>") in payment URIs. Not used for
# matching; off by default to keep QR codes small.
# ZC_INCLUDE_MEMO=false
# ZC_POLL_SECS=15

# --- demo shop -------------------------------------------------------------
SHOP_BIND=127.0.0.1:8081
SHOP_CHECKOUT_URL=http://127.0.0.1:8080
# must equal ZC_API_KEY / ZC_WEBHOOK_SECRET
SHOP_API_KEY=
SHOP_WEBHOOK_SECRET=
